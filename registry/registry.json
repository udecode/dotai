{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "dotai",
  "homepage": "https://github.com/udecode/dotai",
  "items": [
    {
      "name": "dotai",
      "type": "registry:item",
      "title": "Project Initialization",
      "description": "Initialize project with Claude Code settings and skiller",
      "files": [
        {
          "path": "registry/dotai/settings.json",
          "type": "registry:file",
          "target": "~/.claude/settings.json"
        },
        {
          "path": "registry/dotai/docs/1-app-design-document.mdc",
          "type": "registry:file",
          "target": "~/.claude/rules/1-app-design-document.mdc"
        },
        {
          "path": "registry/dotai/docs/3-project-status.mdc",
          "type": "registry:file",
          "target": "~/.claude/rules/3-project-status.mdc"
        },
        {
          "path": "registry/dotai/docs/2-tech-stack.mdc",
          "type": "registry:file",
          "target": "~/.claude/rules/2-tech-stack.mdc"
        },
        {
          "path": "registry/dotai/skiller.toml",
          "type": "registry:file",
          "target": "~/.claude/skiller.toml"
        },
        {
          "path": "registry/dotai/AGENTS.md",
          "type": "registry:file",
          "target": "~/.claude/AGENTS.md"
        }
      ]
    },
    {
      "name": "all",
      "type": "registry:item",
      "title": "Complete Project Setup",
      "description": "Install all dotai plugins",
      "registryDependencies": [
        "https://raw.githubusercontent.com/udecode/dotai/main/registry/dotai.json",
        "https://raw.githubusercontent.com/udecode/dotai/main/registry/prompt.yml"
      ],
      "files": []
    },
    {
      "name": "prompt",
      "type": "registry:item",
      "title": "Prompt Injection System",
      "description": "Dynamic prompt checklists for before-start and before-complete workflows",
      "files": [
        {
          "path": "registry/prompt/config/prompt.yml",
          "type": "registry:file",
          "target": "~/.claude/prompt.yml"
        },
        {
          "path": "registry/prompt/scripts/user-prompt-submit.sh",
          "type": "registry:file",
          "target": "~/.claude/scripts/user-prompt-submit.sh"
        },
        {
          "path": "registry/prompt/scripts/post-compact.sh",
          "type": "registry:file",
          "target": "~/.claude/scripts/post-compact.sh"
        },
        {
          "path": "registry/prompt/scripts/session-start.sh",
          "type": "registry:file",
          "target": "~/.claude/scripts/session-start.sh"
        }
      ]
    }
  ]
}
