{
  "schemaVersion": 1,
  "source": "udecode/dotai",
  "skillsCliVersion": "1.5.25",
  "skills": [
    {
      "name": "plan-page",
      "distribution": "bundled",
      "description": "Write, check, repair and publish a plan page: a project's plans and subject files under its plans directory, rendered by .agents/pstack/plan-page.mjs and rendered as one local HTML page per subject with a local index of every subject, and published to claude.ai at each hand-back for comments and feedback. The page is how work hands back to the user. Use before writing or changing a plan, a subject file in <plans>/topics or its page; at every stop that hands work back, such as a review verdict other than a review-only panel's, a next answer or a playbook's close; when a plan page or its claude.ai artifact looks wrong or refuses to render; to republish a page; or to change the page shape or a playbook's page sections.",
      "category": "Communication",
      "dependencies": [],
      "capabilities": [
        "Node.js 22+ and Git; the renderer that sync-pstack installs in .agents/pstack; the Artifact tool to publish"
      ],
      "provenance": null
    },
    {
      "name": "pstack-pulse",
      "distribution": "bundled",
      "description": "Show every Claude Code and Codex session on the iPhone lock screen through ActivitySmith and in the Mac menubar, with each plan page's pipeline, and buzz when a session needs you, ships or fails.",
      "category": "Monitoring",
      "dependencies": [],
      "capabilities": [
        "macOS with launchd and the Keychain, Node.js 22+ and sqlite3; an ActivitySmith account and key; Tailscale Funnel for the session list"
      ],
      "provenance": null
    },
    {
      "name": "sync-pstack",
      "distribution": "bundled",
      "description": "Set up the pstack plugin in a project through an interview, and keep every pstack project on one pinned tag and one shared AGENTS.md overrides block. Use to set up or install pstack in a repo, sync, bump or update pstack everywhere, list which projects use pstack or have drifted, compare setups, audit a project's skills for drift from pstack (which to cut, fold or keep), change which work runs a panel, architect or an arena without asking (\\\"from now on X runs architect\\\"), or move a workflow lesson, including a plan page shape change, into every project. Not for choosing pstack's per-role models, which setup-pstack owns.",
      "category": "Maintenance",
      "dependencies": [],
      "capabilities": [
        "Node.js 22+ and Git; the Claude Code and Codex CLIs for plugin pins and smoke tests"
      ],
      "provenance": null
    },
    {
      "name": "test-audit",
      "distribution": "bundled",
      "description": "Audit existing tests for low-value, duplicated or implementation-coupled cases and the test-only code they keep alive, then remove or rewrite them on evidence. Use for test-audit, /test-audit <scope>, a test sweep, or pruning tests. Not for writing a new test; the project's Tests rule gates that.",
      "category": "Review",
      "dependencies": [],
      "capabilities": [],
      "provenance": null
    },
    {
      "name": "video-transcripts",
      "distribution": "bundled",
      "description": "Transcribe a supplied local or linked video with Gemini Files API when its contents are needed as evidence.",
      "category": "Communication",
      "dependencies": [],
      "capabilities": [
        "ffmpeg, curl, jq and authorized Gemini credentials"
      ],
      "provenance": null
    },
    {
      "name": "walkthrough",
      "distribution": "bundled",
      "description": "Present final screenshots or rendered artifacts as an annotated walkthrough when visual evidence is requested.",
      "category": "Communication",
      "dependencies": [],
      "capabilities": [
        "Real final-state captures, Node.js and the configured annotation tool"
      ],
      "provenance": null
    }
  ],
