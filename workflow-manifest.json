{
  "schemaVersion": 1,
  "source": "udecode/dotai",
  "skillsCliVersion": "1.5.25",
  "skills": [
    {
      "name": "chips",
      "distribution": "bundled",
      "description": "Run the project's suggested-task ledger: /chips, /chips all, /chips sync, offer, start, drop, merge duplicates, or settle stale tasks. Use for suggested tasks, open chips, and whenever pstack would file a follow-up or out-of-band PR.",
      "category": "Workflow",
      "dependencies": [],
      "capabilities": [
        "Node.js 22+ and Git; the ledger helpers and chips.md rule that sync-pstack installs in .agents/pstack; a suggest tool for cards, with the fallback chips.md gives without one"
      ],
      "provenance": null
    },
    {
      "name": "cleanup",
      "distribution": "bundled",
      "description": "Audit disk usage and remove idle git worktrees, Next.js caches, test Postgres DBs, and unused Bun/npx/uv/Docker caches while preserving active checkouts. Use for /cleanup, /cleanup disk, or freeing worktree/build disk space.",
      "category": "Maintenance",
      "dependencies": [],
      "capabilities": [
        "Node.js 22+, Git and lsof; a session tool that lists sessions with their folders, or a one-day wait before a worktree counts as unused"
      ],
      "provenance": null
    },
    {
      "name": "clip",
      "distribution": "bundled",
      "description": "Record, check and render demo clips or stacked before-and-after images/clips for chat, team posts, social posts, or bug repros. Use before recording any app clip or attaching before/after screenshots.",
      "category": "Communication",
      "dependencies": [],
      "capabilities": [
        "Bun, ffmpeg and ffprobe; Chromium for playwright-core, which the skill installs on first use"
      ],
      "provenance": null
    },
    {
      "name": "mac-watchdog",
      "distribution": "bundled",
      "description": "Keep a Mac from freezing under agent workloads. A user launchd job records memory every 10 seconds, per process and per Claude Code session, and stops any process that grows past 40% of RAM, and a root job restarts fseventsd when its memory leak passes 1 GB. Use to install, check or remove them, after a Mac freezes, swaps hard or logs the user out, when fseventsd holds GBs of memory, or to find which session or process used the memory.",
      "category": "Monitoring",
      "dependencies": [],
      "capabilities": [
        "macOS with launchd, Node.js and the Xcode command line tools for cc; the Claude desktop app to name sessions; sudo once for the fseventsd watchdog"
      ],
      "provenance": null
    },
    {
      "name": "passwords",
      "distribution": "bundled",
      "description": "Set up unattended 1Password access on a Mac or sign in to websites and apps without repeated human approvals. Use for new-device setup, passwords, authenticator codes, email or SMS verification, passkey alternatives, and blocked logins.",
      "category": "Workflow",
      "dependencies": [],
      "capabilities": [
        "macOS login Keychain, 1Password CLI and an account with service-account access; authorized browser or native-app controls that can consume credentials without exposing them"
      ],
      "provenance": null
    },
    {
      "name": "plan-page",
      "distribution": "bundled",
      "description": "Write, check, repair and publish plan pages and topic files rendered by .agents/pstack/plan-page.mjs (local HTML + PR bodies/comments). Use before editing plans/topics, at page-work hand-backs, or when a plan page fails to render.",
      "category": "Communication",
      "dependencies": [],
      "capabilities": [
        "Node.js 22+ and Git; the renderer that sync-pstack installs in .agents/pstack; the Artifact tool to publish"
      ],
      "provenance": null
    },
    {
      "name": "pstack-doctor",
      "distribution": "bundled",
      "description": "Check every running agent session for a stuck or endless loop, find the pstack rule, override or project playbook that drives it, and propose a steer message and a rule fix. Use for /pstack-doctor, \"is any session stuck or endless?\", \"are my sessions making progress?\", a session that has run more than a day, a stop the doctor's Stop hook blocked, and the owner's regular sanity check.",
      "category": "Monitoring",
      "dependencies": [],
      "capabilities": [
        "Node.js 22+, Git and ripgrep; pstack-pulse for live session state, and a session tool that lists sessions for the rest"
      ],
      "provenance": null
    },
    {
      "name": "pstack-pulse",
      "distribution": "bundled",
      "description": "Show every Claude Code and Codex session on the iPhone lock screen through ActivitySmith and in the Mac menubar, with each plan page's pipeline, and buzz when a session needs you, ships or fails.",
      "category": "Monitoring",
      "dependencies": [],
      "capabilities": [
        "macOS with launchd and the Keychain, Node.js 22+ and sqlite3; an ActivitySmith account and key; Tailscale Funnel for the session list"
      ],
      "provenance": null
    },
    {
      "name": "rca",
      "distribution": "bundled",
      "description": "Turn Remote Control on for every non-archived Claude Code session in the Claude desktop app.",
      "category": "Monitoring",
      "dependencies": [],
      "capabilities": [
        "A Code session in the Claude desktop app, which alone has its session tools"
      ],
      "provenance": null
    },
    {
      "name": "redo",
      "distribution": "bundled",
      "description": "Redo a prior pstack run at a higher effort or stronger model, treating its plan as a draft and rerunning only units below target. Use for \\\"redo <plan, page or PR>\\\" or a Babysit levels failure.",
      "category": "Workflow",
      "dependencies": [],
      "capabilities": [],
      "provenance": null
    },
    {
      "name": "sync-pstack",
      "distribution": "bundled",
      "description": "Set up the pstack plugin in a project through an interview, and keep every pstack project on one pinned tag and one shared AGENTS.md overrides block. Use to set up or install pstack in a repo, sync, bump or update pstack everywhere, list which projects use pstack or have drifted, compare setups, audit a project's skills for drift from pstack (which to cut, fold or keep), change which work runs a panel, architect or an arena without asking (\\\"from now on X runs architect\\\"), or move a workflow lesson, including a plan page shape change, into every project. Not for choosing pstack's per-role models, which setup-pstack owns.",
      "category": "Maintenance",
      "dependencies": [],
      "capabilities": [
        "Node.js 22+ and Git; the Claude Code and Codex CLIs for plugin pins and smoke tests"
      ],
      "provenance": null
    },
    {
      "name": "test-audit",
      "distribution": "bundled",
      "description": "Audit existing tests for low-value, duplicated or implementation-coupled cases and prune or rewrite them on evidence (/test-audit full also lists unguarded public contracts). Not for writing new tests.",
      "category": "Review",
      "dependencies": [],
      "capabilities": [],
      "provenance": null
    },
    {
      "name": "video-transcripts",
      "distribution": "bundled",
      "description": "Transcribe a supplied local or linked video from one frame per second with Gemini 4 Neon through agy, or with a Claude subagent when agy fails, and check the transcript against the frames, when a recording's contents are needed as evidence, such as a bug recording on an issue, PR or comment, or a question about what a video shows.",
      "category": "Communication",
      "dependencies": [],
      "capabilities": [
        "ffmpeg, curl, jq and a signed-in agy (Antigravity CLI)"
      ],
      "provenance": null
    },
    {
      "name": "walkthrough",
      "distribution": "bundled",
      "description": "Present final screenshots or rendered artifacts as an annotated walkthrough when visual evidence is requested.",
      "category": "Communication",
      "dependencies": [],
      "capabilities": [
        "Real final-state captures, Node.js and the configured annotation tool"
      ],
      "provenance": null
    },
    {
      "name": "worktree-workspace",
      "distribution": "bundled",
      "description": "Open every git worktree of a project in one VS Code window, each folder labeled by its agent session's title. Use for /worktree-workspace, reviewing worktrees in VS Code, or seeing which worktree holds which task.",
      "category": "Maintenance",
      "dependencies": [],
      "capabilities": [
        "Node.js 22+, Git and the VS Code `code` command; session titles from a sessions file or the Claude desktop app on macOS"
      ],
      "provenance": null
    }
  ],
