{
  "schemaVersion": 1,
  "source": "udecode/dotai",
  "skillsCliVersion": "1.5.25",
  "skills": [
    {
      "name": "chips",
      "distribution": "bundled",
      "description": "Run the project's suggested-task ledger, the chips. /chips alone brings this session's open tasks up to date: it applies what the ledger helper says, settles stale and split tasks, cards what can start and reports the board, and /chips all also takes the ship-list tasks and the ones no live session owns, and merges duplicate tasks across the board. Use for /chips, /chips offer, start or drop, \\\"what chips are open\\\", \\\"suggest a task for X\\\", \\\"update the chips\\\", \\\"clean up the chips\\\", \\\"which chips are stale\\\", \\\"is this chip still worth doing\\\", \\\"merge duplicate chips\\\", at the last hand-back of a run that offered a task, and whenever pstack would file a tracked issue, a follow-up, a reflect Backlog item or an out-of-band PR.",
      "category": "Workflow",
      "dependencies": [],
      "capabilities": [
        "Node.js 22+ and Git; the ledger helpers and chips.md rule that sync-pstack installs in .agents/pstack; a suggest tool for cards, with the fallback chips.md gives without one"
      ],
      "provenance": null
    },
    {
      "name": "cleanup",
      "distribution": "bundled",
      "description": "Free disk in a project by removing the git worktrees and Next.js cache folders nothing uses, keeping every worktree a session or process works in and every cache a running server holds. Use for /cleanup, \\\"clean up worktrees\\\", \\\"free disk space\\\", \\\"what's using my disk\\\", \\\"delete unused worktrees or builds\\\", or when a session-start hint counts old cleanup candidates.",
      "category": "Maintenance",
      "dependencies": [],
      "capabilities": [
        "Node.js 22+, Git and lsof; a session tool that lists sessions with their folders, or a one-day wait before a worktree counts as unused"
      ],
      "provenance": null
    },
    {
      "name": "passwords",
      "distribution": "bundled",
      "description": "Set up unattended 1Password access on a Mac or sign in to websites and apps without repeated human approvals. Use for new-device setup, passwords, authenticator codes, email or SMS verification, passkey alternatives, and blocked logins.",
      "category": "Workflow",
      "dependencies": [],
      "capabilities": [
        "macOS login Keychain, 1Password CLI and an account with service-account access; authorized browser or native-app controls that can consume credentials without exposing them"
      ],
      "provenance": null
    },
    {
      "name": "plan-page",
      "distribution": "bundled",
      "description": "Write, check, repair and publish a plan page: a project's plans and subject files under its plans directory, rendered by .agents/pstack/plan-page.mjs and rendered as one local HTML page per subject with a local index of every subject, and published to claude.ai at each hand-back for comments and feedback. The page is how planned work hands back to the user. Use before writing or changing a plan, a subject file in <plans>/topics or its page; at every stop that hands back work with a plan, such as a review verdict other than a review-only panel's, a next answer or a playbook's close; before writing or updating a PR body, which renders from the PR's plan, or a comment about your commits on someone else's PR; when a plan page or its claude.ai artifact looks wrong or refuses to render; to republish a page; or to change the page shape or a playbook's page sections.",
      "category": "Communication",
      "dependencies": [],
      "capabilities": [
        "Node.js 22+ and Git; the renderer that sync-pstack installs in .agents/pstack; the Artifact tool to publish"
      ],
      "provenance": null
    },
    {
      "name": "pstack-pulse",
      "distribution": "bundled",
      "description": "Show every Claude Code and Codex session on the iPhone lock screen through ActivitySmith and in the Mac menubar, with each plan page's pipeline, and buzz when a session needs you, ships or fails.",
      "category": "Monitoring",
      "dependencies": [],
      "capabilities": [
        "macOS with launchd and the Keychain, Node.js 22+ and sqlite3; an ActivitySmith account and key; Tailscale Funnel for the session list"
      ],
      "provenance": null
    },
    {
      "name": "rca",
      "distribution": "bundled",
      "description": "Turn Remote Control on for every non-archived Claude Code session in the Claude desktop app.",
      "category": "Monitoring",
      "dependencies": [],
      "capabilities": [
        "A Code session in the Claude desktop app, which alone has its session tools"
      ],
      "provenance": null
    },
    {
      "name": "redo",
      "distribution": "bundled",
      "description": "Redo a prior pstack run at the current session's higher effort or stronger model, treating its plan as a draft: rerun only the plan, design, subagent and seat lanes, code and review judgments that ran below the current level, and reuse the rest. Use for \\\"redo <plan, page or PR>\\\", \\\"run poteto again on it at this effort\\\", \\\"treat this plan as a draft\\\", a teammate's run made at a lower effort, or a Babysit whose levels check finds a unit below target.",
      "category": "Workflow",
      "dependencies": [],
      "capabilities": [],
      "provenance": null
    },
    {
      "name": "sync-pstack",
      "distribution": "bundled",
      "description": "Set up the pstack plugin in a project through an interview, and keep every pstack project on one pinned tag and one shared AGENTS.md overrides block. Use to set up or install pstack in a repo, sync, bump or update pstack everywhere, list which projects use pstack or have drifted, compare setups, audit a project's skills for drift from pstack (which to cut, fold or keep), change which work runs a panel, architect or an arena without asking (\\\"from now on X runs architect\\\"), or move a workflow lesson, including a plan page shape change, into every project. Not for choosing pstack's per-role models, which setup-pstack owns.",
      "category": "Maintenance",
      "dependencies": [],
      "capabilities": [
        "Node.js 22+ and Git; the Claude Code and Codex CLIs for plugin pins and smoke tests"
      ],
      "provenance": null
    },
    {
      "name": "test-audit",
      "distribution": "bundled",
      "description": "Audit existing tests for low-value, duplicated or implementation-coupled cases and the test-only code they keep alive, then remove or rewrite them on evidence. /test-audit full covers the whole suite and also lists public contracts no test guards. Use for test-audit, /test-audit <scope>, /test-audit full, a test sweep, or pruning tests. Not for writing a new test; the project's Tests rule gates that.",
      "category": "Review",
      "dependencies": [],
      "capabilities": [],
      "provenance": null
    },
    {
      "name": "video-transcripts",
      "distribution": "bundled",
      "description": "Transcribe a supplied local or linked video with Gemini, or from its frames with a Claude subagent when Gemini fails, and check the transcript against one frame per second, when a recording's contents are needed as evidence, such as a bug recording on an issue, PR or comment, or a question about what a video shows.",
      "category": "Communication",
      "dependencies": [],
      "capabilities": [
        "ffmpeg, curl, jq and authorized Gemini credentials"
      ],
      "provenance": null
    },
    {
      "name": "walkthrough",
      "distribution": "bundled",
      "description": "Present final screenshots or rendered artifacts as an annotated walkthrough when visual evidence is requested.",
      "category": "Communication",
      "dependencies": [],
      "capabilities": [
        "Real final-state captures, Node.js and the configured annotation tool"
      ],
      "provenance": null
    },
    {
      "name": "worktree-workspace",
      "distribution": "bundled",
      "description": "Open every git worktree of a project in one VS Code window, each folder labeled by its agent session's title. Use for /worktree-workspace, reviewing worktrees in VS Code, or seeing which worktree holds which task.",
      "category": "Maintenance",
      "dependencies": [],
      "capabilities": [
        "Node.js 22+, Git and the VS Code `code` command; session titles from a sessions file or the Claude desktop app on macOS"
      ],
      "provenance": null
    }
  ],
