{
  "schemaVersion": 1,
  "source": "udecode/dotai",
  "skillsCliVersion": "1.5.25",
  "skills": [
    {
      "name": "cross-review",
      "distribution": "bundled",
      "description": "Review another agent session's plan or finished work, or a contributor's PR, with a /pstack:interrogate panel briefed from that session's own asks. Fixes a plan still in planning in place; reviews verdicts, executions and PRs read-only. Use for cross-review, $cross-review <plan>, /cross-review, a cross-model review hand-off, or a second opinion on a PR.",
      "category": "Review",
      "dependencies": [],
      "capabilities": [
        "Node.js 18+ and Git; gh with network for a PR, otherwise a locally fetched PR ref"
      ],
      "provenance": null
    },
    {
      "name": "plan-page",
      "distribution": "bundled",
      "description": "Write, check, repair and publish a plan page: a project's plans and subject files under its plans directory, rendered by .agents/pstack/plan-page.mjs and published as one claude.ai page per subject. Use before writing or changing a plan, a subject file in <plans>/topics or its page; when a plan page or its claude.ai artifact looks wrong or refuses to render; to republish a page; or to change the page shape or a playbook's page sections.",
      "category": "Communication",
      "dependencies": [],
      "capabilities": [
        "Node.js 22+ and Git; the renderer that sync-pstack installs in .agents/pstack; the Artifact tool to publish"
      ],
      "provenance": null
    },
    {
      "name": "sync-pstack",
      "distribution": "bundled",
      "description": "Set up the pstack plugin in a project through an interview, and keep every pstack project on one pinned tag and one shared AGENTS.md overrides block. Use to set up or install pstack in a repo, sync, bump or update pstack everywhere, list which projects use pstack or have drifted, compare setups, audit a project's skills for drift from pstack (which to cut, fold or keep), or move a workflow lesson, including a plan page shape change, into every project. Not for choosing pstack's per-role models, which setup-pstack owns.",
      "category": "Maintenance",
      "dependencies": [],
      "capabilities": [
        "Node.js 22+ and Git; the Claude Code and Codex CLIs for plugin pins and smoke tests"
      ],
      "provenance": null
    },
    {
      "name": "test-audit",
      "distribution": "bundled",
      "description": "Audit existing tests for low-value, duplicated or implementation-coupled cases and the test-only code they keep alive, then remove or rewrite them on evidence. Use for test-audit, /test-audit <scope>, a test sweep, or pruning tests. Not for writing a new test; the project's Tests rule gates that.",
      "category": "Review",
      "dependencies": [],
      "capabilities": [],
      "provenance": null
    },
    {
      "name": "video-transcripts",
      "distribution": "bundled",
      "description": "Transcribe a supplied local or linked video with Gemini Files API when its contents are needed as evidence.",
      "category": "Communication",
      "dependencies": [],
      "capabilities": [
        "ffmpeg, curl, jq and authorized Gemini credentials"
      ],
      "provenance": null
    },
    {
      "name": "walkthrough",
      "distribution": "bundled",
      "description": "Present final screenshots or rendered artifacts as an annotated walkthrough when visual evidence is requested.",
      "category": "Communication",
      "dependencies": [],
      "capabilities": [
        "Real final-state captures, Node.js and the configured annotation tool"
      ],
      "provenance": null
    }
  ],
