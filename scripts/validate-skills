#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
SKILLS_DIR="$ROOT/skills"
fail=0

if [ ! -d "$SKILLS_DIR" ]; then
  echo "missing skills/"
  exit 1
fi

shopt -s nullglob
skill_dirs=("$SKILLS_DIR"/*)

if [ "${#skill_dirs[@]}" -eq 0 ]; then
  echo "no skills found"
  exit 1
fi

for skill_dir in "${skill_dirs[@]}"; do
  [ -d "$skill_dir" ] || continue

  skill="$(basename -- "$skill_dir")"
  file="$skill_dir/SKILL.md"

  if [ ! -f "$file" ]; then
    echo "$skill: missing SKILL.md"
    fail=1
    continue
  fi

  if [ "$(sed -n '1p' "$file")" != "---" ]; then
    echo "$skill: missing opening frontmatter"
    fail=1
    continue
  fi

  end_line="$(awk 'NR > 1 && $0 == "---" { print NR; exit }' "$file")"
  if [ -z "$end_line" ]; then
    echo "$skill: missing closing frontmatter"
    fail=1
    continue
  fi

  name="$(sed -n "2,$((end_line - 1))p" "$file" | awk -F': *' '$1 == "name" { print $2; exit }')"
  description="$(sed -n "2,$((end_line - 1))p" "$file" | awk -F': *' '$1 == "description" { print $2; exit }')"

  if [ -z "$name" ]; then
    echo "$skill: missing name"
    fail=1
  elif [ "$name" != "$skill" ]; then
    echo "$skill: name mismatch ($name)"
    fail=1
  fi

  if [ -z "$description" ]; then
    echo "$skill: missing description"
    fail=1
  fi

  # A stray quote inside a double-quoted value breaks the YAML, and the skill silently stops loading.
  broken="$(sed -n "2,$((end_line - 1))p" "$file" | awk '/^[A-Za-z_-]+: *"/ {
    key = substr($0, 1, index($0, ":") - 1); value = $0; sub(/^[^:]*: */, "", value)
    inner = substr(value, 2, length(value) - 2); gsub(/\\./, "", inner)
    if (value !~ /"$/ || inner ~ /"/) print key
  }')"
  if [ -n "$broken" ]; then
    echo "$skill: unescaped double quote inside the quoted frontmatter value: $broken"
    fail=1
  fi
done

# Every session rereads the pstack block on each call, so its budget only goes down: lower it whenever the block shrinks.
block="$SKILLS_DIR/sync-pstack/assets/block.md"
block_budget=39500
block_bytes="$(wc -c < "$block" | tr -d ' ')"
if [ "$block_bytes" -gt "$block_budget" ]; then
  echo "sync-pstack: assets/block.md is $block_bytes bytes, over its $block_budget-byte budget; move a rule's detail into a file under assets/pstack/rules/, register it in RULE_FILES and leave a bullet that says when to read it"
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  exit 1
fi

# No CI runs these, so the commit gate does.
node "$ROOT/scripts/build-workflow.mjs" --check >/dev/null
tests=("$SKILLS_DIR"/*/scripts/*.test.mjs)
if [ "${#tests[@]}" -gt 0 ]; then
  node --test "${tests[@]}" >/dev/null
fi

echo "skills ok"
